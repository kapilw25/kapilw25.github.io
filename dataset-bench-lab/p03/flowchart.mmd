flowchart TB
  subgraph A["① Make the episodes"]
    direction LR
    W[("🏭 SimReady Warehouse-01<br/>Isaac Sim 6.0.1 · GPU")]
    SF[("📄 Scene file = answer key<br/>every object a box:<br/>name, centre, size")]
    EM["🎲 Episode maker<br/>1 to 3 of 50 sub-tasks<br/>≤ 1 outside camera · ≤ 30 steps<br/>20,341 mixes"]
    DCH["🔗 Dependent chain K = 1 to 30<br/>+ a same-length control chain<br/>headline: 3.2 · 3.5 · 5.10 · 3.1"]
    TR["👯 Triple<br/>question · flip twin · keep twin"]
    W -->|export every labelled object| SF --> EM --> DCH --> TR
  end
  subgraph B["② Render on the GPU"]
    direction LR
    R["📸 RGB + depth<br/>watch-only: rendered once, same pixels for all<br/>live slice: rendered on demand"]
    DC{"🔍 Depth check<br/>render matches<br/>the answer key?"}
    R --> DC
    DC -.->|❌ fail: fix first| R
  end
  subgraph C["③ Answer and grade"]
    direction LR
    M["☁️ API models<br/>OpenAI · Claude · Gemini<br/>Kimi-K3 · Qwen · Grok<br/>$2,000 total, capped in code"]
    H["🧑 Human-play page + scripted solver<br/>same pictures, same grader"]
    AL["🔁 Agent loop<br/>watch-only: full history ≤ 30 pictures,<br/>check-ins at steps 3 · 9 · 15 · end<br/>live: last 2 pictures + own notes"]
    G{"⚖️ Grader, rules only<br/>vs the answer key:<br/>answer · drift answers · triple"}
    OUT["📊 accuracy per dial level vs the guess line<br/>triple score · drift at 3, 9, 15<br/>solver and humans ≥ 95%"]
    S3["📦 headline curves<br/>then 447 episodes · then 50,000"]
    M --> AL
    H --> AL
    AL -->|tool calls| G --> OUT --> S3
  end
  A -->|views to render| B
  B -->|✅ depth check passed| C

  classDef done fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#052e16
  classDef ready fill:#fef9c3,stroke:#ca8a04,stroke-width:2px,color:#422006
  classDef queued fill:#e2e8f0,stroke:#64748b,stroke-width:2px,color:#0f172a
  class SF,TR done
  class W,R,DC ready
  class EM,DCH,M,H,AL,G,OUT,S3 queued
