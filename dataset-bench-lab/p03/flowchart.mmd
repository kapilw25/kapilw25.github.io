flowchart TB
  subgraph A["① Make the questions"]
    direction LR
    W[("🏭 SimReady Warehouse-01<br/>Isaac Sim 6.0.1 · GPU")]
    SF[("📄 Scene file = answer key<br/>every object a box:<br/>name, centre, size")]
    QM["❓ Question maker<br/>blue barrel left of the<br/>green box tower? → left"]
    TR["👯 Triple, pair-first<br/>base: left · flip: right · keep: left<br/>camera move · object swap · frame switch"]
    VP["🗺️ View plan<br/>start views · 2 moves away · rest"]
    W -->|export every labelled object| SF --> QM -->|only twinnable questions| TR --> VP
  end
  subgraph B["② Render on the GPU"]
    direction LR
    R["📸 RGB + depth per view<br/>start views first · 60-minute cap"]
    DC{"🔍 Depth check<br/>render matches<br/>the answer key?"}
    R --> DC
    DC -.->|❌ fail: fix first| R
  end
  subgraph C["③ Answer and grade"]
    direction LR
    M["☁️ API models<br/>OpenAI · Google · Anthropic<br/>xAI · Fireworks · Alibaba"]
    H["🧑 Human-play page<br/>same views, same grader"]
    AL["🔁 Agent loop<br/>last 4 views + move log<br/>move · turn · look ≤ 10<br/>measure · answer"]
    G{"⚖️ Grader, rules only<br/>vs the answer key:<br/>answer · each step · triple"}
    OUT["📊 accuracy · step score<br/>triple score · wrong-step %<br/>no-image baseline · label audit"]
    S3["📦 Stage 3<br/>~3,000 triples · release"]
    M --> AL
    H --> AL
    AL -->|tool calls| G --> OUT --> S3
  end
  A -->|views to render| B
  B -->|✅ depth check passed| C

  classDef done fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#052e16
  classDef ready fill:#fef9c3,stroke:#ca8a04,stroke-width:2px,color:#422006
  classDef queued fill:#e2e8f0,stroke:#64748b,stroke-width:2px,color:#0f172a
  class SF,QM,TR,VP done
  class W,R,DC ready
  class M,H,AL,G,OUT,S3 queued
